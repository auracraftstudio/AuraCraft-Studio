# AuraCraft Studio production environment reference.
# Copy values into the matching provider dashboard; never commit real values.

# Render backend
APP_ENV=production
STUDIO_NAME=AuraCraft Studio
BACKEND_PUBLIC_URL=https://auracraft-backend-dt1u.onrender.com
FRONTEND_BASE_URL=https://auracraft-studio.vercel.app
ALLOWED_ORIGINS=https://auracraft-studio.vercel.app
DATABASE_URL=replace_with_neon_connection_string
API_AUTH_TOKEN=replace_with_a_strong_random_shared_token
TELEGRAM_API_PROXY_URL=https://auracraft-studio-edge.auracraftstudio.workers.dev/telegram-api
TELEGRAM_WEBHOOK_URL=https://auracraft-studio-edge.auracraftstudio.workers.dev/webhook
TELEGRAM_IMPORT_ALLOWED_HOSTS=replace_with_explicit_allowed_hosts

# Cloudflare Worker secrets (set in Cloudflare, not in Vercel or this file):
# API_AUTH_TOKEN                 same value as Render's API_AUTH_TOKEN
# TELEGRAM_BOT_TOKEN             Telegram bot token
# TELEGRAM_WEBHOOK_SECRET        Telegram webhook validation secret
# TELEGRAM_GROUP_CHAT_ID         private Telegram group identifier
# TELEGRAM_TOPIC_ID              allowed Telegram topic identifier
# TELEGRAM_ALLOWED_USER_IDS      comma-separated allowlist of user IDs

# Worker identity and public base URL (non-secret)
CLOUDFLARE_WORKER_NAME=auracraft-studio-edge
CLOUDFLARE_WORKER_ROUTE=https://auracraft-studio-edge.auracraftstudio.workers.dev

# Vercel production environment
# VITE_API_URL=https://auracraft-studio-edge.auracraftstudio.workers.dev
# Set this only after all Worker secrets are configured and the Worker is deployed.
# Never create VITE_API_AUTH_TOKEN; browser bundles must not contain API secrets.
